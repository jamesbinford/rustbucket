# Rustbucket Environment Configuration
# Copy this file to .env and fill in your values

# Required: ChatGPT API Key
CHATGPT_API_KEY=sk-your-openai-api-key-here

# S3 Logging (Optional)
S3_LOGGING_ENABLED=false
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_PREFIX=
S3_DELETE_AFTER_UPLOAD=false

# AWS Credentials (Optional - only needed if not using IAM roles)
# Leave empty if running on EC2/ECS with IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Registry Integration (Optional)
# Leave empty to skip registration
RUSTBUCKET_REGISTRY_URL=
