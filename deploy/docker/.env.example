# Rustbucket Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose ONE provider and set its API key. Uncomment the one you want to use.

# Option 1: OpenAI (default)
OPENAI_API_KEY=sk-your-openai-api-key-here
# CHATGPT_API_KEY=sk-...  # Legacy alias for OPENAI_API_KEY

# Option 2: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Option 3: Google Gemini
# GEMINI_API_KEY=AIza-your-gemini-api-key-here

# Option 4: Ollama (local - no API key required)
# Just ensure Ollama is running: ollama serve
# Configure ollama_host in Config.toml if not using localhost:11434

# S3 Logging (Optional)
S3_LOGGING_ENABLED=false
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_PREFIX=
S3_DELETE_AFTER_UPLOAD=false

# AWS Credentials (Optional - only needed if not using IAM roles)
# Leave empty if running on EC2/ECS with IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Registry Integration (Optional)
# Leave empty to skip registration
RUSTBUCKET_REGISTRY_URL=
